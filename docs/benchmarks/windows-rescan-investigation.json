  "checkpoint_frequency_control": {
    "run": "https://github.com/Shisetsu-Code/Everything/actions/runs/43413318046",
    "commit": "c4e436b0d6eebfb1e3458df2d31a9fd0465e355f",
    "raw_report": "windows-checkpoint-control.json",
    "artifact_sha256": "b50bb6ea0d8f280849a9fb79d2db52c86335fd6d95c8f9e2491b917008da1367",
    "medians_seconds": {
      "1000": 28.406903999999997,
      "16384": 14.434091949999981
    },
    "speedup_16384_over_1000": 1.968042333276118,
    "method": "One native Windows executable, alternating AB/BA, byte-identical generation-1 seed copies. Total subprocess time includes final PASSIVE checkpoint and connection close.",
    "conclusion": "Commit/checkpoint cost dominates. Larger autocheckpoint threshold lowers total rescan time even though the final checkpoint takes longer. No evidence here attributes the delay to antivirus or user hardware.",
    "limits": "Two samples per threshold, first rescan 1->2 only, synthetic 100000-file tree; no cold-cache, steady-state generation or real 8.5-million-catalog claim.",
    "production_policy": "Use 16384 pages only during scan writes; restore 1000 before the final PASSIVE checkpoint. Watcher/import/default connections retain the original policy. Keep WAL, synchronous=NORMAL, 32 MiB cache, temp_store=FILE and schema 1."
  }
